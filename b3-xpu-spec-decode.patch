+# Small speculative verification batches otherwise use the chunk-prefill
+# kernel, which has no split-K parallelism across a long KV cache.  This is
+# the current upstream Intel XPU exact route: represent every causal query
+# position as one q_len=1 paged-decode sequence with an adjusted KV length.
+try:
+    _SPEC_DECODE_MAX_QLEN = int(
+        os.environ.get("VLLM_XPU_SPEC_DECODE_MAX_QLEN", "16")
+    )
+except ValueError:
+    _SPEC_DECODE_MAX_QLEN = 16
+
+
+def _spec_decode_varlen_fwd(
+    q,
+    k,
+    v,
+    out,
+    cu_seqlens_q,
+    seqused_k,
+    block_table,
+    max_seqlen_k,
+    k_descale,
+    v_descale,
+    softmax_scale,
+    s_aux,
+    window_size,
+    softcap,
+):
+    batch = cu_seqlens_q.numel() - 1
+    q_len = q.shape[0] // batch
+    total = q.shape[0]
+    cu_seqlens_q_spec = torch.arange(
+        total + 1, dtype=torch.int32, device=q.device
+    )
+    dummy_cu_seqlens_k = torch.zeros_like(cu_seqlens_q_spec)
+    pos = torch.arange(q_len, device=q.device, dtype=seqused_k.dtype)
+    seqused_k_spec = (
+        seqused_k.view(batch, 1)
+        - (q_len - 1 - pos).view(1, q_len)
+    ).clamp_(min=1).reshape(total).to(torch.int32)
+    block_table_spec = block_table.repeat_interleave(q_len, dim=0)
+
+    out, _ = torch.ops._vllm_fa2_C.varlen_fwd(
+        q,
+        k,
+        v,
+        out,
+        cu_seqlens_q_spec,
+        dummy_cu_seqlens_k,
+        seqused_k_spec,
+        None,
+        block_table_spec,
+        None,
+        1,
+        max_seqlen_k,
+        0.0,
+        k_descale,
+        v_descale,
+        softmax_scale,
+        s_aux,
+        False,
+        False,
+        window_size[0],
+        window_size[1],
+        softcap,
+        False,
+        None,
+        None,
+        False,
+        None,
+    )
+    return out
+
+
 def maybe_contiguous(x):
     return x.contiguous() if x is not None and x.stride(-1) != 1 else x
 
